# ==========================================
# CropSaathi Backend - Environment Variables
# ==========================================

# --- Google Cloud & BigQuery ---
# The primary GCP Project ID for the backend services
GCP_PROJECT_ID=cropsaathi-production-123
# The BigQuery Dataset containing the telemetry and NDVI historical data
BIGQUERY_DATASET=agricultural_telemetry_dpg

# --- Google Earth Engine (GEE) ---
# Absolute path to the Earth Engine Service Account JSON key for satellite imagery access
GEE_SERVICE_ACCOUNT_JSON_PATH=/path/to/gee-auth-key.json

# --- Generative AI (Gemini) ---
# Gemini API Key used for generating localized farming advisories (e.g., Malwi translations)
# Note: Ensure the key has access to Gemini 1.5 Pro or Gemini 2.0 Flash for optimal reasoning
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# --- Firebase Cloud Messaging (FCM) ---
# Used for the DPG Mesh Architecture to send cross-border disease outbreak push notifications
FCM_SERVER_KEY=AAAA_YOUR_LEGACY_OR_V1_FCM_SERVER_KEY_HERE
FCM_SENDER_ID=123456789012
